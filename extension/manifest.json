{
  "manifest_version": 3,
  "name": "Halo — Circle & Ask",
  "version": "0.1.0",
  "description": "Crop a section or ask about a whole page, then keep talking with a tutor through text, voice, and handwritten explanations.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "tabs", "storage", "sidePanel", "scripting", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Halo — open side panel (Alt+C to crop)" },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "setup.html",
  "commands": {
    "toggle-draw": {
      "suggested_key": { "default": "Alt+C", "mac": "Alt+C" },
      "description": "Toggle Halo crop mode"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/*", "pdf.html", "pdf.worker.min.mjs"], "matches": ["<all_urls>"] }
  ],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
