# Copy to .env and fill in.

# Brain: gemini (default) or claude
HALO_PROVIDER=gemini
GEMINI_API_KEY=AIza...
# Optional model override. Default gemini-3.5-flash (clearer explanations, ~1.4 s to first token). gemini-3.5-flash-lite is faster but shallower.
HALO_MODEL=gemini-3.5-flash
# Optional thinking depth. Gemini 3+: GEMINI_THINKING_LEVEL=minimal|low|medium|high (default minimal).
# Gemini 2.x: GEMINI_THINKING_BUDGET=<tokens> (default 0).
# GEMINI_THINKING_LEVEL=minimal

# Only needed if HALO_PROVIDER=claude
ANTHROPIC_API_KEY=

# ElevenLabs. Leave empty to skip server TTS; the extension falls back to browser speech.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=fZboLjcdZSF1lt1yyuXM
# One model for every step so the voice never changes mid-answer (~0.9 s per clip).
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Full-quality audio. mp3_22050_32 sounds like a phone call.
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Image generation for complex concepts (the "image" ink primitive)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# "Halo watches you work" (/api/check, LangGraph). Defaults to HALO_MODEL when that is a Gemini model.
# HALO_CHECK_MODEL=gemini-3.5-flash
# Optional: see every check as a trace (read → verify → judge) at smith.langchain.com.
# Traces include the image of the student's working.
# LANGSMITH_TRACING=true
LANGSMITH_API_KEY=

PORT=8787
# Set HALO_MOCK=1 to serve canned answers with no API calls (offline demo fallback)
HALO_MOCK=0
